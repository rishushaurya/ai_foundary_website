# AI Foundry Web Platform - Environment Variables Configuration

# 1. Google OAuth 2.0 (Google Identity Services)
# Get free from: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2. JWT Secret for Cryptographically Signed 7-Day Admin Cookies
JWT_SECRET=ai-foundry-production-jwt-secret-key-2026

# 3. Master Admin Passkey (Optional fallback password)
ADMIN_PASSWORD=admin

# 4. Free Cloud Database (Upstash Redis / Vercel KV) - Optional for cloud CMS persistence
# Create free at https://upstash.com or 1-click in Vercel Storage tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
